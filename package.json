{
  "name": "ruili-rpa",
  "version": "0.2.0",
  "description": "锐流 RPA —— 对标影刀 RPA 的 Windows 桌面自动化客户端（阶段 1：骨架与壳）",
  "main": "out/main/index.js",
  "author": "ruili-rpa",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "lint": "eslint .",
    "format": "prettier --write .",
    "smoke": "electron-vite build && electron .",
    "demo:engine": "vite-node scripts/demo-run.ts",
    "poc:web": "vite-node scripts/poc-web.ts",
    "poc:excel": "vite-node scripts/poc-excel.ts",
    "poc:sidecar": "vite-node scripts/poc-sidecar.ts",
    "poc:llm": "vite-node scripts/poc-llm.ts",
    "poc:exit": "vite-node scripts/poc-exit.ts",
    "bench:selectors": "vite-node scripts/selector-real-bench.ts",
    "poc:m1": "vite-node scripts/poc-m1-e2e.ts",
    "test:sidecar": "python -m pytest sidecar/tests -q",
    "license:check": "license-checker --summary",
    "dist": "electron-vite build && electron-builder --win nsis",
    "build:sidecar": "vite-node scripts/build-sidecar.ts"
  },
  "dependencies": {
    "@types/nodemailer": "^8.0.2",
    "better-sqlite3": "^13.0.3",
    "croner": "^9.1.0",
    "docx": "^9.7.2",
    "electron-updater": "^6.8.9",
    "exceljs": "^4.4.0",
    "imapflow": "^2.0.7",
    "nodemailer": "^10.0.10",
    "pdf-lib": "^1.17.1",
    "playwright-core": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router-dom": "^7.18.4",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.6.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@vitest/coverage-v8": "^3.2.7",
    "electron": "^44.4.5",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "eslint": "^10.11.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "license-checker": "^25.0.1",
    "linkedom": "^0.18.13",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vite": "^7.3.6",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "com.ruili.rpa",
    "productName": "锐流RPA",
    "directories": {
      "output": "dist-installer"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/better-sqlite3/**/*"
    ],
    "extraResources": [
      {
        "from": "build/python",
        "to": "python"
      }
    ],
    "win": {
      "target": "nsis",
      "icon": "build/icon.png",
      "artifactName": "ruili-rpa-${version}-setup.${ext}",
      "fileAssociations": [
        {
          "ext": "rui",
          "name": "锐流RPA流程包"
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "锐流RPA"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "uwjtg",
        "repo": "ruili-rpa"
      }
    ],
    "npmRebuild": false
  }
}
